<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dayflow_ai.DashboardTemplate">
        <div class="dayflow-dashboard-container">
            <!-- Header Bar -->
            <div class="dayflow-header-banner">
                <div>
                    <h1 class="h3 font-weight-bold mb-1" style="color: #0f172a;">DAYFLOW AI</h1>
                    <p class="text-muted mb-0 small">
                        Predict workforce risks. Automate HR decisions. Improve productivity.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary mr-2" t-on-click="loadDashboardData">
                        <i class="fa fa-refresh mr-1"></i> Refresh Data
                    </button>
                    <button class="btn btn-primary" t-on-click="openCopilot" style="background-color: #4f46e5; border-color: #4f46e5;">
                        <i class="fa fa-magic mr-1"></i> Launch AI HR Copilot
                    </button>
                </div>
            </div>

            <!-- KPI Cards Grid -->
            <div class="dayflow-kpi-grid">
                <!-- Workforce Health Score Dial -->
                <div class="dayflow-health-dial">
                    <div>
                        <div class="small text-uppercase font-weight-bold" style="opacity: 0.85;">Workforce Health</div>
                        <div class="dayflow-health-score-val"><t t-esc="state.kpi.workforce_health"/> / 100</div>
                        <div class="small mt-1" style="opacity: 0.9;">
                            <i class="fa fa-shield mr-1"></i> Organization Index
                        </div>
                    </div>
                    <i class="fa fa-heartbeat fa-3x" style="opacity: 0.3;"></i>
                </div>

                <!-- Total Employees -->
                <div class="dayflow-metric-card">
                    <div class="text-muted small font-weight-bold text-uppercase">Total Headcount</div>
                    <div class="h2 font-weight-bold mt-2 mb-1" style="color: #0f172a;"><t t-esc="state.kpi.total_employees"/></div>
                    <div class="small text-success">
                        <i class="fa fa-users mr-1"></i> Across 5 Departments
                    </div>
                </div>

                <!-- Present Today -->
                <div class="dayflow-metric-card">
                    <div class="text-muted small font-weight-bold text-uppercase">Present Today</div>
                    <div class="h2 font-weight-bold mt-2 mb-1 text-success"><t t-esc="state.kpi.present_today"/></div>
                    <div class="small text-muted">
                        <t t-esc="state.kpi.attendance_pct"/>% Attendance Rate
                    </div>
                </div>

                <!-- On Leave Today -->
                <div class="dayflow-metric-card">
                    <div class="text-muted small font-weight-bold text-uppercase">On Leave</div>
                    <div class="h2 font-weight-bold mt-2 mb-1" style="color: #3b82f6;"><t t-esc="state.kpi.on_leave_today"/></div>
                    <div class="small text-muted">
                        Scheduled &amp; Approved
                    </div>
                </div>

                <!-- Absent Today -->
                <div class="dayflow-metric-card">
                    <div class="text-muted small font-weight-bold text-uppercase">Absent Today</div>
                    <div class="h2 font-weight-bold mt-2 mb-1 text-danger"><t t-esc="state.kpi.absent_today"/></div>
                    <div class="small text-danger font-weight-bold">
                        Unscheduled Absences
                    </div>
                </div>

                <!-- High Risk Attention Required -->
                <div class="dayflow-metric-card" style="border-left: 4px solid #ef4444;">
                    <div class="text-danger small font-weight-bold text-uppercase">High Risk (Requires Attention)</div>
                    <div class="h2 font-weight-bold mt-2 mb-1 text-danger"><t t-esc="state.kpi.high_risk_count"/></div>
                    <div class="small text-danger">
                        Score ≥ 70 Tier
                    </div>
                </div>
            </div>

            <!-- Two-Column Content Grid -->
            <div class="dayflow-dashboard-grid-2col">
                <!-- Left Column: Department Health & Attention Employees -->
                <div>
                    <!-- Department Intelligence Table -->
                    <div class="card p-3 shadow-sm border-0 mb-4" style="border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="font-weight-bold mb-0" style="color: #0f172a;">Department Workforce Intelligence</h5>
                            <span class="badge badge-light">Real-time Capacity</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Department</th>
                                        <th>Headcount</th>
                                        <th>Present</th>
                                        <th>Availability %</th>
                                        <th>Health Index</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
                                        <tr>
                                            <td class="font-weight-bold"><t t-esc="dept.name"/></td>
                                            <td><t t-esc="dept.total_staff"/></td>
                                            <td><t t-esc="dept.present_today"/></td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="mr-2 font-weight-bold"><t t-esc="dept.availability_pct"/>%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <strong style="color: #4f46e5;"><t t-esc="dept.workforce_health_score"/>/100</strong>
                                            </td>
                                            <td>
                                                <span t-if="dept.workforce_health_score &gt;= 80" class="badge badge-success">Optimal</span>
                                                <span t-elif="dept.workforce_health_score &gt;= 65" class="badge badge-info">Stable</span>
                                                <span t-elif="dept.workforce_health_score &gt;= 50" class="badge badge-warning">Attention</span>
                                                <span t-else="" class="badge badge-danger">Critical</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Employees Requiring HR Attention -->
                    <div class="card p-3 shadow-sm border-0" style="border-radius: 12px;">
                        <h5 class="font-weight-bold mb-3" style="color: #0f172a;">Staff Requiring HR Attention (Risk Score ≥ 65)</h5>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Department</th>
                                        <th>Risk Score</th>
                                        <th>Attendance %</th>
                                        <th>Absences</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.attention_employees" t-as="emp" t-key="emp.id">
                                        <tr>
                                            <td class="font-weight-bold"><t t-esc="emp.name"/></td>
                                            <td class="text-muted"><t t-esc="emp.department"/></td>
                                            <td>
                                                <span class="badge badge-danger px-2 py-1">Score: <t t-esc="emp.risk_score"/> [HIGH]</span>
                                            </td>
                                            <td><t t-esc="emp.attendance_rate"/>%</td>
                                            <td class="text-danger font-weight-bold"><t t-esc="emp.absences"/> days</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" t-on-click="() =&gt; this.openEmployeeRisk(emp.id)">
                                                    Review
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Proactive Alerts & AI Insights -->
                <div>
                    <!-- Proactive HR Alerts -->
                    <div class="card p-3 shadow-sm border-0 mb-4" style="border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="font-weight-bold mb-0" style="color: #0f172a;">Proactive Alerts</h5>
                            <button class="btn btn-sm btn-link p-0" t-on-click="openAlerts">View All</button>
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="state.alerts" t-as="alert" t-key="alert.id">
                                <div class="p-3 border rounded" style="background-color: #fffaf0; border-left: 4px solid #f59e0b !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="font-weight-bold mb-1" style="font-size: 13px;"><t t-esc="alert.title"/></h6>
                                        <span class="badge badge-warning text-dark"><t t-esc="alert.severity"/></span>
                                    </div>
                                    <p class="small text-muted mb-1"><t t-esc="alert.reason"/></p>
                                    <div class="small font-weight-bold" style="color: #4f46e5;">
                                        👉 <t t-esc="alert.recommended_action"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- AI Insights Panel -->
                    <div class="card p-3 shadow-sm border-0" style="border-radius: 12px; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);">
                        <h5 class="font-weight-bold mb-3" style="color: #0f172a;">AI Workforce Insights</h5>
                        <t t-foreach="state.insights" t-as="ins" t-key="ins.headline">
                            <div class="mb-3 pb-3 border-bottom">
                                <h6 class="font-weight-bold text-dark mb-1" style="font-size: 13px;"><t t-esc="ins.headline"/></h6>
                                <p class="small text-muted mb-1"><t t-esc="ins.description"/></p>
                                <div class="small text-primary font-weight-bold">
                                    💡 <t t-esc="ins.recommended_action"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
