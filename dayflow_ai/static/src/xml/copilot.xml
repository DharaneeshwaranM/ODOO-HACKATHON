<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dayflow_ai.CopilotTemplate">
        <div class="dayflow-copilot-container">
            <div class="dayflow-copilot-header">
                <div>
                    <h5 class="mb-0 font-weight-bold text-white"><i class="fa fa-magic mr-2"></i> DAYFLOW AI HR COPILOT</h5>
                    <small class="text-white-50">Natural Language Workforce Query Assistant • Real Odoo ORM Grounded</small>
                </div>
                <span class="badge badge-success px-3 py-1">Online &amp; Connected</span>
            </div>

            <!-- Suggestion Chips Bar -->
            <div class="p-3 bg-light border-bottom">
                <span class="small font-weight-bold text-muted d-block mb-2">QUICK HR QUESTIONS:</span>
                <div class="d-flex flex-wrap">
                    <t t-foreach="state.suggestions" t-as="sug" t-key="sug">
                        <span class="dayflow-suggestion-chip" t-on-click="() =&gt; this.sendPrompt(sug)">
                            <t t-esc="sug"/>
                        </span>
                    </t>
                </div>
            </div>

            <!-- Messages Area -->
            <div class="dayflow-copilot-chatbox" t-ref="chatContainer">
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <div t-if="msg.sender === 'user'" class="dayflow-message-user">
                        <div class="font-weight-bold small mb-1 opacity-75">You</div>
                        <div><t t-esc="msg.text"/></div>
                        <div class="text-right small mt-1 opacity-50"><t t-esc="msg.timestamp"/></div>
                    </div>
                    <div t-else="" class="dayflow-message-bot">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge badge-primary mr-2" style="background-color: #4f46e5;">Dayflow Copilot</span>
                            <span class="small text-muted"><t t-esc="msg.timestamp"/></span>
                        </div>
                        <div style="white-space: pre-line; line-height: 1.6;"><t t-esc="msg.text"/></div>
                    </div>
                </t>
                <div t-if="state.isLoading" class="dayflow-message-bot">
                    <i class="fa fa-circle-o-notch fa-spin mr-2 text-primary"></i> Querying live Odoo HR data and calculating workforce metrics...
                </div>
            </div>

            <!-- Input Bar -->
            <div class="dayflow-copilot-inputbar">
                <input type="text"
                       class="form-control"
                       placeholder="Ask anything about today's attendance, department capacity, employee risk, or leave impact..."
                       t-model="state.inputPrompt"
                       t-on-keydown="onKeyDown"
                       t-att-disabled="state.isLoading"/>
                <button class="btn btn-primary px-4"
                        t-on-click="() =&gt; this.sendPrompt()"
                        t-att-disabled="state.isLoading || !state.inputPrompt"
                        style="background-color: #4f46e5; border-color: #4f46e5;">
                    <i class="fa fa-paper-plane mr-1"></i> Ask
                </button>
            </div>
        </div>
    </t>

</templates>
