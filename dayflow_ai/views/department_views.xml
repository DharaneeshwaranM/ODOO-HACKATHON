<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.department.form.dayflow.inherit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="dayflow_dept_health" string="Dayflow Workforce Intelligence">
                        <group>
                            <group string="Real-Time Capacity &amp; Attendance">
                                <field name="total_staff"/>
                                <field name="present_today"/>
                                <field name="absent_today"/>
                                <field name="on_leave_today"/>
                                <field name="attendance_pct" widget="percentage"/>
                                <field name="availability_pct" widget="percentage"/>
                            </group>
                            <group string="Workforce Risk &amp; Health Index">
                                <field name="workforce_health_score" widget="progressbar"/>
                                <field name="health_status" widget="badge"
                                       decoration-success="health_status == 'excellent'"
                                       decoration-info="health_status == 'good'"
                                       decoration-warning="health_status == 'warning'"
                                       decoration-danger="health_status == 'critical'"/>
                                <field name="average_risk_score"/>
                                <field name="high_risk_count"/>
                            </group>
                        </group>
                        <group string="Department Diagnosis &amp; Executive Summary">
                            <field name="health_summary" nolabel="1" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Department Kanban Customization -->
    <record id="hr_department_view_kanban_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.department.kanban.dayflow.inherit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.hr_department_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_card_content')]" position="inside">
                <div class="row mt-2 border-top pt-2">
                    <div class="col-6">
                        <span class="text-muted small">Availability:</span>
                        <strong class="d-block"><field name="availability_pct"/>%</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small">Health Score:</span>
                        <strong class="d-block text-primary"><field name="workforce_health_score"/>/100</strong>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
