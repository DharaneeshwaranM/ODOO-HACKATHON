<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dayflow_workforce_risk_tree" model="ir.ui.view">
        <field name="name">dayflow.workforce.risk.tree</field>
        <field name="model">dayflow.workforce.risk</field>
        <field name="arch" type="xml">
            <tree string="Workforce Risk Assessments">
                <field name="assessment_date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="risk_score" widget="progressbar"/>
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"/>
                <field name="reasons"/>
            </tree>
        </field>
    </record>

    <record id="view_dayflow_workforce_risk_form" model="ir.ui.view">
        <field name="name">dayflow.workforce.risk.form</field>
        <field name="model">dayflow.workforce.risk</field>
        <field name="arch" type="xml">
            <form string="Workforce Risk Assessment">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="assessment_date"/>
                        </group>
                        <group>
                            <field name="risk_score" widget="progressbar"/>
                            <field name="risk_level" widget="badge"
                                   decoration-success="risk_level == 'low'"
                                   decoration-warning="risk_level == 'medium'"
                                   decoration-danger="risk_level == 'high'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Penalty Components Breakdown">
                            <group>
                                <field name="attendance_penalty"/>
                                <field name="absence_penalty"/>
                                <field name="punctuality_penalty"/>
                                <field name="leave_intensity_penalty"/>
                                <field name="trend_penalty"/>
                            </group>
                        </page>
                        <page string="Reasons &amp; Action Plan">
                            <group string="Identified Risk Factors">
                                <field name="reasons" nolabel="1"/>
                            </group>
                            <group string="HR Prescriptive Recommendation">
                                <field name="recommendation" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
