<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat for Payslip -->
    <record id="action_report_dayflow_payslip" model="ir.actions.report">
        <field name="name">Dayflow Employee Salary Slip</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dayflow_ai.report_dayflow_payslip_document</field>
        <field name="report_file">dayflow_ai.report_dayflow_payslip_document</field>
        <field name="print_report_name">'Payslip - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_dayflow_payslip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e293b;">
                        <!-- Header Header Info -->
                        <div class="row mb-4 border-bottom pb-3">
                            <div class="col-8">
                                <h2 style="color: #4f46e5; font-weight: 700; margin-bottom: 2px;">DAYFLOW AI</h2>
                                <h4 class="text-muted" style="font-size: 16px; font-weight: 500;">CONFIDENTIAL EMPLOYEE SALARY SLIP</h4>
                                <p class="small text-muted mb-0">Generated by Dayflow AI Payroll Engine • Odoo 17</p>
                            </div>
                            <div class="col-4 text-right">
                                <span class="badge badge-primary px-3 py-2" style="font-size: 13px; background-color: #4f46e5;">
                                    Pay Period: Current Month
                                </span>
                            </div>
                        </div>

                        <!-- Employee Info Table -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td style="width: 40%; font-weight: 600; color: #64748b;">Employee Name:</td>
                                        <td style="font-weight: 700;"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 600; color: #64748b;">Employee Badge ID:</td>
                                        <td><span t-field="o.employee_badge_id"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 600; color: #64748b;">Job Position:</td>
                                        <td><span t-field="o.job_title"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td style="width: 40%; font-weight: 600; color: #64748b;">Department:</td>
                                        <td><span t-field="o.department_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 600; color: #64748b;">Attendance Rate:</td>
                                        <td><span t-field="o.attendance_rate"/>%</td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 600; color: #64748b;">Email:</td>
                                        <td><span t-field="o.work_email"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Salary Breakdown Table -->
                        <div class="row mb-4">
                            <!-- Earnings -->
                            <div class="col-6">
                                <div class="card p-3 border" style="border-radius: 8px;">
                                    <h5 style="color: #059669; font-weight: 700; border-bottom: 2px solid #d1fae5; padding-bottom: 6px;">EARNINGS</h5>
                                    <table class="table table-sm mt-2 mb-0">
                                        <tr>
                                            <td>Basic Wage</td>
                                            <td class="text-right font-weight-bold"><span t-field="o.monthly_wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr>
                                            <td>House Rent Allowance (HRA)</td>
                                            <td class="text-right font-weight-bold"><span t-field="o.hra_allowance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr>
                                            <td>Special Allowance</td>
                                            <td class="text-right font-weight-bold"><span t-field="o.special_allowance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr class="border-top" style="background-color: #f8fafc;">
                                            <td style="font-weight: 700;">Gross Earnings</td>
                                            <td class="text-right font-weight-bold" style="color: #059669;">
                                                <t t-set="gross" t-value="o.monthly_wage + o.hra_allowance + o.special_allowance"/>
                                                <span t-esc="gross" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Deductions -->
                            <div class="col-6">
                                <div class="card p-3 border" style="border-radius: 8px;">
                                    <h5 style="color: #dc2626; font-weight: 700; border-bottom: 2px solid #fee2e2; padding-bottom: 6px;">DEDUCTIONS</h5>
                                    <table class="table table-sm mt-2 mb-0">
                                        <tr>
                                            <td>Provident Fund (<span t-field="o.provident_fund_rate"/>%)</td>
                                            <td class="text-right font-weight-bold">
                                                <t t-set="pf_amount" t-value="round(o.monthly_wage * (o.provident_fund_rate / 100.0), 2)"/>
                                                <span t-esc="pf_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Income Tax TDS (<span t-field="o.tax_deduction_rate"/>%)</td>
                                            <td class="text-right font-weight-bold">
                                                <t t-set="tax_amount" t-value="round(o.monthly_wage * (o.tax_deduction_rate / 100.0), 2)"/>
                                                <span t-esc="tax_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr class="border-top" style="background-color: #f8fafc;">
                                            <td style="font-weight: 700;">Total Deductions</td>
                                            <td class="text-right font-weight-bold" style="color: #dc2626;">
                                                <t t-set="total_deductions" t-value="pf_amount + tax_amount"/>
                                                <span t-esc="total_deductions" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Net Pay Banner -->
                        <div class="card p-4 text-center my-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); color: white; border-radius: 12px;">
                            <h4 class="mb-1 text-uppercase" style="letter-spacing: 1px; font-size: 14px; opacity: 0.9;">NET TAKE HOME SALARY</h4>
                            <t t-set="net_salary" t-value="gross - total_deductions"/>
                            <h1 style="font-size: 38px; font-weight: 800; margin: 0;">
                                <span t-esc="net_salary" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </h1>
                        </div>

                        <!-- Footer Signatures -->
                        <div class="row mt-5 pt-4">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto; padding-top: 8px;">
                                    <p class="small text-muted mb-0 font-weight-bold">Employee Signature</p>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto; padding-top: 8px;">
                                    <p class="small text-muted mb-0 font-weight-bold">Authorized HR Signatory (Dayflow AI)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
