<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.tree.dayflow.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="check_out" position="after">
                <field name="working_hours_actual" widget="float_time"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'late'"
                       decoration-info="status == 'half_day'"/>
                <field name="late_minutes" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_view_filter_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.filter.dayflow.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='today']" position="after">
                <filter string="Late Check-ins" name="late_checkins" domain="[('is_late', '=', True)]"/>
                <filter string="Half Days" name="half_days" domain="[('status', '=', 'half_day')]"/>
            </xpath>
        </field>
    </record>
</odoo>
