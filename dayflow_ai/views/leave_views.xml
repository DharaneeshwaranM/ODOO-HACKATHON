<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.dayflow.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- High / Medium Leave Impact Warning Banner -->
                <div class="alert alert-danger mb-3 p-3 shadow-sm" role="alert"
                     invisible="impact_level != 'high'">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-exclamation-triangle fa-2x mr-3 text-danger"></i>
                        <div>
                            <h5 class="alert-heading mb-1 font-weight-bold">CRITICAL WORKFORCE CAPACITY IMPACT DETECTED</h5>
                            <p class="mb-0 small">
                                <field name="impact_recommendation" readonly="1"/>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning mb-3 p-3 shadow-sm" role="alert"
                     invisible="impact_level != 'medium'">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle fa-2x mr-3 text-warning"></i>
                        <div>
                            <h5 class="alert-heading mb-1 font-weight-bold">MODERATE CAPACITY IMPACT</h5>
                            <p class="mb-0 small">
                                <field name="impact_recommendation" readonly="1"/>
                            </p>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <group string="Dayflow Smart Leave Impact Analysis" class="mt-3">
                    <group>
                        <field name="impact_level" widget="badge"
                               decoration-success="impact_level == 'low'"
                               decoration-warning="impact_level == 'medium'"
                               decoration-danger="impact_level == 'high'"/>
                        <field name="current_availability_pct" widget="percentage"/>
                        <field name="projected_availability_pct" widget="percentage"/>
                    </group>
                    <group>
                        <field name="has_overlap_warning"/>
                        <field name="overlap_count"/>
                        <field name="overlapping_employees_str" invisible="not has_overlap_warning"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_tree_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.leave.tree.dayflow.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="impact_level" widget="badge"
                       decoration-success="impact_level == 'low'"
                       decoration-warning="impact_level == 'medium'"
                       decoration-danger="impact_level == 'high'"/>
                <field name="projected_availability_pct" widget="percentage"/>
                <field name="has_overlap_warning" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
