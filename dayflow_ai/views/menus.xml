<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dayflow AI Root Menu -->
    <menuitem id="menu_dayflow_root"
              name="Dayflow AI"
              web_icon="dayflow_ai,static/description/icon.png"
              sequence="10"/>

    <!-- Top-Level Actions -->
    <record id="action_dayflow_dashboard" model="ir.actions.client">
        <field name="name">Workforce Dashboard</field>
        <field name="tag">dayflow_dashboard_tag</field>
    </record>

    <record id="action_dayflow_copilot" model="ir.actions.client">
        <field name="name">AI HR Copilot</field>
        <field name="tag">dayflow_copilot_tag</field>
    </record>

    <record id="action_dayflow_employee_risk" model="ir.actions.act_window">
        <field name="name">Employee Risk Intelligence</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_group_risk_level': 1}</field>
    </record>

    <record id="action_dayflow_department_health" model="ir.actions.act_window">
        <field name="name">Department Intelligence</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="action_dayflow_alerts" model="ir.actions.act_window">
        <field name="name">Proactive HR Alerts</field>
        <field name="res_model">dayflow.workforce.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_unread': 1}</field>
    </record>

    <record id="action_dayflow_insights" model="ir.actions.act_window">
        <field name="name">AI Insights &amp; Recommendations</field>
        <field name="res_model">dayflow.hr.insight</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_dayflow_attendance_view" model="ir.actions.act_window">
        <field name="name">Attendance Monitoring</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="action_dayflow_leave_view" model="ir.actions.act_window">
        <field name="name">Leave Management &amp; Impact</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
    </record>

    <!-- Submenus -->
    <menuitem id="menu_dayflow_dashboard"
              name="Dashboard"
              parent="menu_dayflow_root"
              action="action_dayflow_dashboard"
              sequence="10"/>

    <menuitem id="menu_dayflow_intelligence"
              name="Workforce Intelligence"
              parent="menu_dayflow_root"
              sequence="20"/>

    <menuitem id="menu_dayflow_emp_risk"
              name="Employee Risk"
              parent="menu_dayflow_intelligence"
              action="action_dayflow_employee_risk"
              sequence="10"/>

    <menuitem id="menu_dayflow_dept_health"
              name="Department Health"
              parent="menu_dayflow_intelligence"
              action="action_dayflow_department_health"
              sequence="20"/>

    <menuitem id="menu_dayflow_alerts_sub"
              name="Proactive Alerts"
              parent="menu_dayflow_intelligence"
              action="action_dayflow_alerts"
              sequence="30"/>

    <menuitem id="menu_dayflow_insights_sub"
              name="AI Insights"
              parent="menu_dayflow_intelligence"
              action="action_dayflow_insights"
              sequence="40"/>

    <menuitem id="menu_dayflow_copilot_menu"
              name="AI HR Copilot"
              parent="menu_dayflow_root"
              action="action_dayflow_copilot"
              sequence="30"/>

    <menuitem id="menu_dayflow_operations"
              name="HR Operations"
              parent="menu_dayflow_root"
              sequence="40"/>

    <menuitem id="menu_dayflow_attendance_sub"
              name="Attendance"
              parent="menu_dayflow_operations"
              action="action_dayflow_attendance_view"
              sequence="10"/>

    <menuitem id="menu_dayflow_leave_sub"
              name="Leave Management"
              parent="menu_dayflow_operations"
              action="action_dayflow_leave_view"
              sequence="20"/>
</odoo>
