<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auth_verification_success" name="Dayflow Email Verification Success">
        <t t-call="web.layout">
            <div class="container mt-5 text-center">
                <div class="card shadow-lg p-5 mx-auto" style="max-width: 500px; border-radius: 16px;">
                    <div class="mb-4">
                        <i class="fa fa-check-circle text-success" style="font-size: 64px;"></i>
                    </div>
                    <h2 class="font-weight-bold text-dark">Email Verified Successfully!</h2>
                    <p class="text-muted mt-2">
                        Welcome <strong t-esc="employee_name"/>! Your account (<strong t-esc="email"/>) has been fully activated in Dayflow AI.
                    </p>
                    <a href="/web/login" class="btn btn-primary btn-lg mt-4 px-4" style="border-radius: 8px;">
                        Proceed to Sign In
                    </a>
                </div>
            </div>
        </t>
    </template>

    <template id="auth_verification_failed" name="Dayflow Email Verification Failed">
        <t t-call="web.layout">
            <div class="container mt-5 text-center">
                <div class="card shadow-lg p-5 mx-auto" style="max-width: 500px; border-radius: 16px;">
                    <div class="mb-4">
                        <i class="fa fa-times-circle text-danger" style="font-size: 64px;"></i>
                    </div>
                    <h2 class="font-weight-bold text-dark">Verification Failed</h2>
                    <p class="text-muted mt-2" t-esc="error_message"/>
                    <a href="/web/login" class="btn btn-secondary btn-lg mt-4 px-4" style="border-radius: 8px;">
                        Back to Login
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
