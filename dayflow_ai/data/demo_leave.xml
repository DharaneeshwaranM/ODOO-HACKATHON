<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sales Overlapping Leaves Scenario: John Smith & Priya Sharma requesting concurrent dates -->
        <record id="demo_leave_john_smith" model="hr.leave">
            <field name="name">Annual Medical &amp; Family Leave</field>
            <field name="employee_id" ref="demo_emp_john_smith"/>
            <field name="holiday_status_id" model="hr.leave.type" eval="obj().search([], limit=1).id"/>
            <field name="date_from" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="date_to" eval="(datetime.now() + timedelta(days=6)).strftime('%Y-%m-%d 18:00:00')"/>
            <field name="number_of_days">5</field>
            <field name="state">validate</field>
        </record>

        <!-- Priya Sharma Pending Leave (Overlaps with John Smith) -->
        <record id="demo_leave_priya_sharma" model="hr.leave">
            <field name="name">Client Travel Rest Day</field>
            <field name="employee_id" ref="demo_emp_priya_sharma"/>
            <field name="holiday_status_id" model="hr.leave.type" eval="obj().search([], limit=1).id"/>
            <field name="date_from" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="date_to" eval="(datetime.now() + timedelta(days=5)).strftime('%Y-%m-%d 18:00:00')"/>
            <field name="number_of_days">3</field>
            <field name="state">confirm</field>
        </record>

        <!-- Marketing Leave: Elena Rostova on Leave Today -->
        <record id="demo_leave_elena_active" model="hr.leave">
            <field name="name">Personal PTO</field>
            <field name="employee_id" ref="demo_emp_elena_rostova"/>
            <field name="holiday_status_id" model="hr.leave.type" eval="obj().search([], limit=1).id"/>
            <field name="date_from" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="date_to" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 18:00:00')"/>
            <field name="number_of_days">3</field>
            <field name="state">validate</field>
        </record>
    </data>
</odoo>
