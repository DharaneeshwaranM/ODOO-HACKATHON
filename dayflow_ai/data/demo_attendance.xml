<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Alex Chen On-time Attendances -->
        <record id="demo_att_alex_1" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_alex_chen"/>
            <field name="check_in" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 08:55:00')"/>
            <field name="check_out" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d 17:30:00')"/>
        </record>
        <record id="demo_att_alex_today" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_alex_chen"/>
            <field name="check_in" eval="datetime.now().strftime('%Y-%m-%d 08:50:00')"/>
        </record>

        <!-- Marcus Vance Late Attendance -->
        <record id="demo_att_marcus_1" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_marcus_vance"/>
            <field name="check_in" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d 10:20:00')"/>
            <field name="check_out" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d 17:00:00')"/>
        </record>

        <!-- Sarah Jenkins Attendances -->
        <record id="demo_att_sarah_today" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_sarah_jenkins"/>
            <field name="check_in" eval="datetime.now().strftime('%Y-%m-%d 09:05:00')"/>
        </record>

        <!-- Clara Oswald Attendances -->
        <record id="demo_att_clara_today" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_clara_oswald"/>
            <field name="check_in" eval="datetime.now().strftime('%Y-%m-%d 08:45:00')"/>
        </record>

        <!-- James Wilson Attendances -->
        <record id="demo_att_james_today" model="hr.attendance">
            <field name="employee_id" ref="demo_emp_james_wilson"/>
            <field name="check_in" eval="datetime.now().strftime('%Y-%m-%d 09:00:00')"/>
        </record>
    </data>
</odoo>
