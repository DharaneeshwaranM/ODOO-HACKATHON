<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Verification Template -->
        <record id="mail_template_email_verification" model="mail.template">
            <field name="name">Dayflow: Email Verification</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Verify your Dayflow AI Account</field>
            <field name="email_from">{{ (object.company_id.email or 'noreply@dayflow.ai') }}</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 10px;">
                    <h2 style="color: #4f46e5;">Welcome to Dayflow AI</h2>
                    <p>Hello <t t-out="object.name"/>,</p>
                    <p>Thank you for registering your employee account. Please click the button below to verify your work email and activate your account:</p>
                    <div style="text-align: center; margin: 30px 0;">
                        <a t-att-href="ctx.get('verification_url')" style="background-color: #4f46e5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; display: inline-block;">
                            Verify My Email Address
                        </a>
                    </div>
                    <p style="color: #64748b; font-size: 13px;">This single-use verification link will expire in 24 hours.</p>
                </div>
            </field>
        </record>

        <!-- Leave Submitted Template (To Manager/HR) -->
        <record id="mail_template_leave_submitted" model="mail.template">
            <field name="name">Dayflow: Leave Request Submitted</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">New Leave Request: {{ object.employee_id.name }} (Impact: {{ object.impact_level }})</field>
            <field name="email_from">{{ (object.employee_id.work_email or 'noreply@dayflow.ai') }}</field>
            <field name="email_to">{{ object.department_id.manager_id.work_email or object.company_id.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h3>New Leave Request Submitted</h3>
                    <p><strong>Employee:</strong> <t t-out="object.employee_id.name"/></p>
                    <p><strong>Department:</strong> <t t-out="object.department_id.name"/></p>
                    <p><strong>Dates:</strong> <t t-out="object.date_from"/> to <t t-out="object.date_to"/></p>
                    <p><strong>Dayflow Impact Assessment:</strong> <t t-out="object.impact_level"/></p>
                    <p><strong>Projected Department Availability:</strong> <t t-out="object.projected_availability_pct"/>%</p>
                </div>
            </field>
        </record>

        <!-- Leave Approved Template -->
        <record id="mail_template_leave_approved" model="mail.template">
            <field name="name">Dayflow: Leave Request Approved</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Your Leave Request Has Been Approved</field>
            <field name="email_from">{{ (object.company_id.email or 'noreply@dayflow.ai') }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h3 style="color: #10b981;">Leave Request Approved</h3>
                    <p>Hello <t t-out="object.employee_id.name"/>,</p>
                    <p>Your leave request from <t t-out="object.date_from"/> to <t t-out="object.date_to"/> has been approved.</p>
                </div>
            </field>
        </record>

        <!-- Leave Rejected Template -->
        <record id="mail_template_leave_rejected" model="mail.template">
            <field name="name">Dayflow: Leave Request Declined</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Notice Regarding Your Leave Request</field>
            <field name="email_from">{{ (object.company_id.email or 'noreply@dayflow.ai') }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h3 style="color: #ef4444;">Leave Request Notice</h3>
                    <p>Hello <t t-out="object.employee_id.name"/>,</p>
                    <p>Your leave request for <t t-out="object.date_from"/> has been declined due to department capacity constraints.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
